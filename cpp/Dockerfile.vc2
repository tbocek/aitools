FROM arch:latest

#https://github.com/IAHispano/Applio
RUN sudo pacman -Sy --noconfirm && \
    # alsa-plugins carries libasound_module_pcm_pulse.so. Arch's portaudio is
    # built with only the ALSA and OSS host APIs -- no native PulseAudio one --
    # so the realtime tab enumerates zero devices unless ALSA itself is bridged
    # to the pipewire-pulse socket handed in by docker-compose.
    sudo pacman -S --noconfirm ffmpeg libsndfile portaudio alsa-plugins alsa-lib && \
    sudo pacman -Scc --noconfirm

RUN git clone https://github.com/IAHispano/Applio
RUN cd /home/arch/Applio && \
    # 3.12 matches upstream's own Dockerfile and is the newest interpreter for
    # which TheRock publishes BOTH torch and torchaudio linux wheels at the same
    # nightly (cp310/cp312/cp314 exist, but only cp312 is a version Applio targets).
    uv venv --python 3.12 && \
    # requirements.txt pins torch==2.11.0/torchaudio==2.11.0 from PyPI, i.e. the
    # CUDA builds -- ~3GB downloaded only to be thrown away, and hip=None so the
    # GPU is never seen. Drop the pins and install ROCm wheels FIRST, so the
    # transitive torch requirements of torchcrepe/torchfcpe/transformers resolve
    # against what is already there instead of re-fetching from PyPI.
    sed -i -E '/^(torch|torchaudio)==/d' requirements.txt && \
    # Pin both to the SAME nightly: torchaudio's _torchaudio.abi3.so links against
    # the exact torch it was built for, and a mismatch fails at import with
    # "undefined symbol: torch_library_impl".
    # NOTE: gfx1151 tops out at torch 2.9.1 while Applio asks for 2.11.0. There is
    # no ROCm 2.11 wheel for this GPU, so this is a deliberate downgrade.
    uv pip install --index-url https://rocm.nightlies.amd.com/v2/gfx1151/ \
        "torch==2.9.1+rocm7.13.0a20260513" \
        "torchaudio==2.9.0+rocm7.13.0a20260513" && \
    uv pip install -r requirements.txt

# check_the_device() drops every device without "hw:" in its name when on linux,
# i.e. raw ALSA hardware only. In a container there is no raw hardware -- audio
# arrives over the pipewire-pulse socket -- so the realtime tab lists nothing at
# all. Delete the clause rather than allowlisting names, so any PCM added to
# asound.conf above shows up without another patch. The remaining channel-count
# check still filters out anything unusable.
RUN sed -i '/if sys.platform == "linux" and "hw:" not in device\["name"\]:/,+1d' \
    /home/arch/Applio/rvc/realtime/audio.py && \
    ! grep -q 'hw:' /home/arch/Applio/rvc/realtime/audio.py

# The ALSA "pulse" PCM advertises 32 channels, and Applio opens the stream with
# whatever the device reports. process_data() then does librosa.to_mono(), i.e.
# a mean across ALL channels -- but pipewire only fills the first two, so the
# other 30 are digital silence and the voice arrives ~24dB down: meter reads
# nothing and the converted output is inaudible. Clamp to stereo.
RUN sed -i \
    -e 's/max_input_channels=d\["max_input_channels"\],/max_input_channels=min(2, d["max_input_channels"]),/g' \
    -e 's/max_output_channels=d\["max_output_channels"\],/max_output_channels=min(2, d["max_output_channels"]),/g' \
    /home/arch/Applio/rvc/realtime/audio.py && \
    test "$(grep -c 'min(2, d\[' /home/arch/Applio/rvc/realtime/audio.py)" = 4

# Inference runs in a separate worker process, and the audio callback only ever
# polls for a finished block (retrieve() is get_nowait). When a block is late,
# change_voice() returns self._last_output -- the PREVIOUS chunk, verbatim. That
# is audible as an echo: recordings here contained bit-exact duplicates at
# exactly one block period (measured: corr=1.000 at 749ms with a 750ms chunk),
# and it fires whenever anything else on the box competes for the GPU/CPU (OBS
# encoding with x264 is enough, even at x1.49 idle headroom).
#
# Two changes:
#   1. retrieve() gains an optional bounded wait, so normal jitter is absorbed by
#      latency instead of turning into a repeat.
#   2. The replay fallback becomes silence. A short gap is far less damaging to a
#      recording than a duplicated syllable, and it stays audible as a defect
#      rather than masquerading as speech. The stderr warning makes the rate
#      measurable in "docker compose logs vc2".
RUN python3 - <<'PY'
import io, re
w = "/home/arch/Applio/rvc/realtime/worker.py"
s = io.open(w).read()
old = """        result = None
        while True:
            try:
                result = self._output_q.get_nowait()
            except Empty:
                break
        if result is not None:"""
new = """        result = None
        while True:
            try:
                result = self._output_q.get_nowait()
            except Empty:
                break
        if result is None and timeout:
            try:
                result = self._output_q.get(timeout=timeout)
            except Empty:
                result = None
        if result is not None:"""
assert s.count(old) == 1, "worker.retrieve body moved"
assert s.count("    def retrieve(self):") == 1, "worker.retrieve signature moved"
s = s.replace(old, new).replace("    def retrieve(self):", "    def retrieve(self, timeout=None):")
io.open(w, "w").write(s)

c = "/home/arch/Applio/rvc/realtime/callbacks.py"
s = io.open(c).read()
old = """        self._last_output = None
        self._last_vol = 0"""
new = """        self._last_output = None
        self._last_vol = 0
        # Wait up to most of one block for a late result before giving up.
        self._block_wait = 0.9 * read_chunk_size * 128 / AUDIO_SAMPLE_RATE"""
assert s.count(old) == 1, "callbacks.__init__ anchor moved"
s = s.replace(old, new)

old = "        result = self.vc.retrieve()"
assert s.count(old) == 1, "callbacks retrieve call moved"
s = s.replace(old, "        result = self.vc.retrieve(timeout=self._block_wait)")

old = """        # No result ready yet; replay previous output to avoid underrun.
        if (
            self._last_output is not None
            and self._last_output.shape[0] == received_data.shape[0]
        ):
            return self._last_output, self._last_vol, [0, 0, 0], None

        return np.zeros(received_data.shape[0], dtype=np.float32), 0, [0, 0, 0], None"""
new = """        # Still nothing after the wait. Emit silence rather than replaying
        # self._last_output: a repeated chunk is an audible echo in recordings.
        print("realtime: block deadline missed, emitting silence", file=sys.stderr)
        return np.zeros(received_data.shape[0], dtype=np.float32), 0, [0, 0, 0], None"""
assert s.count(old) == 1, "callbacks replay fallback moved"
s = s.replace(old, new)
io.open(c, "w").write(s)
print("patched worker.py + callbacks.py")
PY

# Kept after the pip layer on purpose: editing the routing must not invalidate
# the ~3GB torch install above.
# PortAudio's ALSA backend builds its device list by walking the top-level "pcm"
# nodes of the ALSA config, so a named PCM here becomes a selectable entry in
# Applio's device dropdowns. "VoiceChanger" pins the stream to the null sink
# run.sh creates, whose monitor is republished as the VoiceChangerMic capture
# device -- that is what OBS/Discord/Jami record. The plugin's own "device" key
# beats $PULSE_SINK, so "pulse"/"default" stay on the speakers and remain usable
# for monitoring yourself.
RUN printf '%s\n' \
        'pcm.!default { type pulse }' \
        'ctl.!default { type pulse }' \
        'pcm.VoiceChanger {' \
        '    type pulse' \
        '    device "VoiceChanger"' \
        '    hint { show on  description "VoiceChanger" }' \
        '}' \
    | sudo tee /etc/asound.conf >/dev/null

ENV PATH="/home/arch/Applio/.venv/bin:${PATH}"
WORKDIR /home/arch/Applio
EXPOSE 6969
