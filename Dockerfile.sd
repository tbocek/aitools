FROM arch:latest

#https://github.com/leejet/stable-diffusion.cpp
RUN git -c http.version=HTTP/1.1 clone --recursive https://github.com/leejet/stable-diffusion.cpp 
RUN cd /home/arch/stable-diffusion.cpp/examples/server/frontend && pnpm install

ENV ROCM_PATH=/opt/rocm/core \
    HIP_PATH=/opt/rocm/core \
    PATH="/opt/rocm/core/bin:/opt/rocm/core/lib/llvm/bin:${PATH}" \
    ROCBLAS_USE_HIPBLASLT=1

RUN cd /home/arch/stable-diffusion.cpp && cmake -B build -G "Ninja" \
    -DCMAKE_C_COMPILER=/opt/rocm/core/lib/llvm/bin/clang \
    -DCMAKE_CXX_COMPILER=/opt/rocm/core/lib/llvm/bin/clang++ \
    -DCMAKE_INSTALL_RPATH="/opt/rocm/core/lib/llvm/lib;/opt/rocm/core/lib" \
    -DCMAKE_BUILD_WITH_INSTALL_RPATH=ON \
    -DSD_HIPBLAS=ON \
    -DSD_VULKAN=ON \
    -DSD_SERVER_BUILD_FRONTEND=ON \
    -DCMAKE_BUILD_TYPE=Release \
    -DAMDGPU_TARGETS=gfx1151 \
    -DGPU_TARGETS=gfx1151 \
    -DCMAKE_POSITION_INDEPENDENT_CODE=ON && \
    cmake --build build --config Release --parallel
