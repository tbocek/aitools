FROM arch:latest

#https://github.com/ggml-org/llama.cpp/blob/master/docs/build.md
RUN git -c http.version=HTTP/1.1 clone https://github.com/ggml-org/llama.cpp
RUN cd llama.cpp/tools/ui && npm ci && npm run build

ENV ROCM_PATH=/opt/rocm/core \
    HIP_PATH=/opt/rocm/core \
    PATH="/opt/rocm/core/bin:/opt/rocm/core/lib/llvm/bin:${PATH}" \
    ROCBLAS_USE_HIPBLASLT=1

# Tests/examples off + single target: only llama-server and the libs it needs
# (the ggml HIP/Vulkan kernels still dominate compile time -- those are
# dependencies of the server, not skippable).
RUN cd /home/arch/llama.cpp && cmake -B build \
    -DGGML_HIP=ON \
    -DGGML_NATIVE=ON \
    -DAMDGPU_TARGETS=gfx1151 \
    -DGGML_CUDA_FA_ALL_QUANTS=ON \
    -DGGML_VULKAN=ON \
    -DLLAMA_BUILD_WEBUI=ON \
    -DLLAMA_USE_PREBUILT_WEBUI=OFF \
    -DLLAMA_BUILD_TESTS=OFF \
    -DLLAMA_BUILD_EXAMPLES=OFF \
    -DCMAKE_BUILD_TYPE=Release \
    && cmake --build build --config Release --parallel --target llama-server
